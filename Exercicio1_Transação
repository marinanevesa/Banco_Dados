create database Vestibular
use Vestibular 

create table Candidato (
	CodCan int constraint pk_codCon primary key,
	Nome varchar(50),
	Endereco varchar(50),
	CPF varchar(20),
	RG varchar(20),
	Situacao varchar(50) constraint ck_situacaoCand check (Situacao in ('Aprovado', 'Reprovado', 'Aprovado 2 chamada'))
)

create table Pagamento(
	CodPag int constraint pk_CodPag primary key,
	VlPago money,
	VlJurosMulta money,
	dtVencto datetime constraint df_dtVenc default(getdate() + 10),
	dtPagto datetime,
	dtRegistro datetime 
)

create table Curso(
	CodCur int constraint pk_CodCur primary key,
	Nome varchar(50),
	CargaHoraria int constraint ck_cargaHoraria check (CargaHoraria = 2800 or CargaHoraria = 3600),
	NroVagas int
)

create table Inscricao(
	CodIns int constraint pk_CodIns primary  key,
	Nota float,
	AnoInscr int,
	DataInscricao date constraint df_dtRegistro Default(getdate()),
	CodCan int constraint fk_CodCan foreign key references Candidato(CodCan),
	Opcao1 int constraint fk_opcao1 foreign key references Curso(CodCur),
	Opcao2 int constraint fk_opcao2 foreign key references Curso(CodCur),
	constraint ck_opcoes check (Opcao1 != Opcao2),
	Situacao varchar(50) constraint ck_situacaoInscr check (Situacao in ('Aguardando Pgmnt', 'Cancelado', 'Encerrado', 'Pago')),
	constraint uq_AnoInscr unique(AnoINscr, CodCan),
	CodPag int constraint fk_CodPag foreign key references Pagamento(CodPag)
)

